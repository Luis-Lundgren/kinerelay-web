# ==============================================================================
# KineRelay Web Application Environment Variables
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control.
# ==============================================================================

# Database Connection (PostgreSQL - Owned canonically by kinerelay-web)
# DATABASE_URL: Connection pooled URL (e.g. Supabase connection pooler on port 6543)
DATABASE_URL="postgresql://postgres:password@localhost:5432/kinerelay?schema=public"
# DIRECT_URL: Direct database connection URL (used by Prisma migrations)
DIRECT_URL="postgresql://postgres:password@localhost:5432/kinerelay?schema=public"

# NextAuth Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-random-secret-here-with-openssl-rand-hex-32"

# Google OAuth (Optional - for Google Login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# KineRelay Teleop Backend Service Integration
# CRITICAL: KINERELAY_API_TOKEN and KINERELAY_WS_TICKET_SECRET are server-side ONLY secrets.
# NEVER commit real values to Git or prefix them with NEXT_PUBLIC_.
# Generate separate random secrets using:
#   openssl rand -hex 32  # For KINERELAY_API_TOKEN
#   openssl rand -hex 32  # For KINERELAY_WS_TICKET_SECRET
KINERELAY_TELEOP_HTTP_URL="http://localhost:8500"
KINERELAY_API_TOKEN="replace-with-strong-random-service-token"          # Must match KINERELAY_API_TOKEN on kinerelay-teleop
KINERELAY_WS_TICKET_SECRET="replace-with-separate-random-ticket-secret" # Must match KINERELAY_WS_TICKET_SECRET on kinerelay-teleop

# Browser-visible URL only — no credentials
NEXT_PUBLIC_KINERELAY_TELEOP_WS_URL="ws://localhost:8500/ws"
KINERELAY_TELEOP_RECORDS_PATH="/path/to/kinerelay-teleop/records"

# Deprecated compatibility fallbacks (planned removal after migration window):
# EMBODEX_TELEOP_HTTP_URL="http://localhost:8500"
# EMBODEX_API_TOKEN="fallback-token"
# EMBODEX_WS_TICKET_SECRET="fallback-secret"
# NEXT_PUBLIC_EMBODEX_TELEOP_WS_URL="ws://localhost:8500/ws"
# EMBODEX_TELEOP_RECORDS_PATH="/path/to/kinerelay-teleop/records"
# NEXT_PUBLIC_TELEGRIP_HTTP_URL="http://localhost:8500"
# NEXT_PUBLIC_TELEGRIP_WS_URL="ws://localhost:8500"
# TELEGRIP_RECORDS_PATH="/path/to/kinerelay-teleop/records"

# Email Delivery (Resend - Optional)
RESEND_API_KEY=""
SMTP_FROM="noreply@kinerelay.site"

# reCAPTCHA / Bot Protection (Optional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
GOOGLE_CLOUD_PROJECT_ID=""
